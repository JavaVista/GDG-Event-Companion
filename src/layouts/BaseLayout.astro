---
import '../styles/global.css';
import AppShell from '../components/AppShell.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'GDG Event Companion',
  description = 'A companion web application for GDG event attendees',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <!-- PWA & Mobile Icons -->
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}favicon.png`}
    />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}icons/apple-touch-icon.png`}
    />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />

    <!-- PWA & Theme Color Meta Tags -->
    <meta name="theme-color" id="meta-theme-color" content="#4285f4" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="GDG Event Companion" />

    <!-- iOS / iPhone Compatibility Metadata -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="GDG Companion" />

    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts (Google Sans Flex & Google Sans Code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Code:wght@400;500;600;700&family=Google+Sans+Flex:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- SEO and Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          const swPath =
            document
              .querySelector('link[rel="manifest"]')
              ?.href.replace(/site\.webmanifest$/, 'sw.js') || '/sw.js';
          navigator.serviceWorker.register(swPath).catch((err) => {
            console.warn('ServiceWorker registration failed:', err);
          });
        });
      }
    </script>

    <!-- Synchronous inline script to apply colors and prevent Flash of Un-themed Content (FOUC) -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'gdg-active-theme-config-id';
        const activeThemeId =
          localStorage.getItem(STORAGE_KEY) || 'gdg-default';
        document.documentElement.setAttribute('data-theme', activeThemeId);

        const themes = {
          'gdg-default': {
            primary: '#4285f4',
            secondary: '#34a853',
            accent: '#f9ab00',
            background: '#ffffff',
            surface: '#ffffff',
            text: '#1e1e1e',
            mutedText: '#5f6368',
          },
          'gdg-devfest': {
            primary: '#ea4335',
            secondary: '#4285f4',
            accent: '#f9ab00',
            background: '#0f172a',
            surface: '#1e293b',
            text: '#f8fafc',
            mutedText: '#94a3b8',
          },
          'holiday-generic': {
            primary: '#b3261e',
            secondary: '#137333',
            accent: '#e0b034',
            background: '#faf8f5',
            surface: '#ffffff',
            text: '#1c1b1f',
            mutedText: '#6b6357',
          },
        };

        const theme = themes[activeThemeId] || themes['gdg-default'];
        const root = document.documentElement;

        root.style.setProperty('--md-sys-color-primary', theme.primary);
        root.style.setProperty('--md-sys-color-secondary', theme.secondary);
        root.style.setProperty('--md-sys-color-accent', theme.accent);
        root.style.setProperty('--md-sys-color-background', theme.background);
        root.style.setProperty('--md-sys-color-surface', theme.surface);
        root.style.setProperty('--md-sys-color-text', theme.text);
        root.style.setProperty('--md-sys-color-muted', theme.mutedText);
        root.style.setProperty('--md-sys-color-on-background', theme.text);
        root.style.setProperty('--md-sys-color-on-surface', theme.text);
        root.style.setProperty(
          '--md-sys-color-on-surface-variant',
          theme.mutedText
        );

        const meta = document.getElementById('meta-theme-color');
        if (meta) {
          const colorVal =
            theme.background === '#ffffff' || theme.background === '#faf8f5'
              ? theme.primary
              : theme.background;
          meta.setAttribute('content', colorVal);
        }
      })();
    </script>

    <!-- Complete client-side bundling of full theme options (icons, shapes, gradients) -->
    <script>
      import { getActiveTheme, applyTheme } from '../config/themes';
      applyTheme(getActiveTheme());
    </script>
  </head>
  <body>
    <AppShell>
      <slot />
    </AppShell>
  </body>
</html>
