---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeSelector from '../../components/ThemeSelector.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="Theme Settings | GDG Event Companion"
  description="Manage global event branding and theme styles"
>
  <div class="flex flex-col gap-4 py-2">
    <!-- Top Header & Navigation -->
    <div class="flex justify-between items-center gap-4 w-full">
      <a
        href="/organizer/dashboard"
        class="flex items-center gap-1 text-xs font-black text-primary hover:underline cursor-pointer select-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Dashboard
      </a>
      <h2
        class="text-xs font-extrabold text-on-surface-variant uppercase tracking-wider"
      >
        Theme Settings
      </h2>
    </div>

    <!-- Header Title & Info Callout -->
    <div class="flex flex-col gap-1.5 mt-1">
      <h1 class="text-xl font-black text-on-surface flex items-center gap-2">
        App Active Theme
      </h1>
      <p class="text-xs text-on-surface-variant leading-relaxed">
        Select a brand theme below. Colors, hero patterns, and custom semantic
        icons update globally across the entire app and persist automatically.
      </p>
    </div>

    <!-- Note Card: Event Occasions -->
    <div
      class="card card-outlined border-primary/20 bg-primary/5 p-4 rounded-2xl flex flex-col gap-2"
    >
      <div class="flex items-center gap-2 text-primary font-extrabold text-xs">
        <Icon name="theme" size={16} />
        <span>Organizer Event Themes Note</span>
      </div>
      <p class="text-xs text-on-surface-variant leading-relaxed font-medium">
        Custom themes can be switched dynamically for special GDG community
        occasions such as <strong>GDG DevFest</strong>, <strong
          >Build with AI</strong
        >, <strong>Google I/O Extended</strong>, <strong
          >Holiday Celebrations</strong
        >, and future events. All theme and icon overrides are globally
        supported across every page.
      </p>
    </div>

    <!-- Theme Selector Grid -->
    <div class="mt-2 w-full">
      <ThemeSelector />
    </div>
  </div>
</BaseLayout>

<script>
  import { isUnlocked } from '../../lib/organizer-auth';

  const baseUrl = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL.slice(0, -1)
    : import.meta.env.BASE_URL;

  // Client-side guard: if locked, redirect to unlock portal index
  if (!isUnlocked()) {
    window.location.replace(`${baseUrl}/organizer`);
  }
</script>
