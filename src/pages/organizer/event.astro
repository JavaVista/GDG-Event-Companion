---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventDetailsView from '../../components/EventDetailsView.astro';
import EventOrganizerNotes from '../../components/EventOrganizerNotes.astro';
import Icon from '../../components/Icon.astro';
import { fetchBevyEvents } from '../../services/bevy-events-service';
import { getLiveOrNextEvent } from '../../lib/bevy';

const allEvents = await fetchBevyEvents().catch(() => []);
const currentEvent = getLiveOrNextEvent(allEvents);
---

<BaseLayout
  title="Current Event Manager | GDG Event Companion"
  description="Manage active event details, links, and local organizer notes"
>
  <div id="event-page-container" class="flex flex-col gap-5 py-2">
    <!-- Navigation Header Row -->
    <div class="flex items-center justify-between gap-4 w-full">
      <a
        href={`${import.meta.env.BASE_URL}organizer/dashboard`}
        class="flex items-center gap-1 text-xs font-black text-primary hover:underline cursor-pointer select-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Dashboard
      </a>
      <h2
        class="text-sm font-extrabold text-on-surface-variant uppercase tracking-wider"
      >
        Event Manager
      </h2>
    </div>

    <!-- Main Content Container -->
    <div id="organizer-event-container" class="w-full">
      {
        currentEvent ? (
          <div class="flex flex-col gap-6">
            <EventDetailsView event={currentEvent} />
            <div class="border-t border-outline/10 my-1" />
            <EventOrganizerNotes eventId={currentEvent.id} />
          </div>
        ) : (
          <div class="card card-outlined border-outline/25 p-8 flex flex-col items-center justify-center text-center gap-3.5 bg-surface/40 rounded-[28px]">
            <div class="w-12 h-12 rounded-full bg-on-surface/5 flex items-center justify-center text-on-surface-variant/40">
              <Icon name="offline" size={24} />
            </div>
            <div class="flex flex-col gap-1">
              <h3 class="text-sm font-extrabold text-on-surface">
                No Active Event Found
              </h3>
              <p class="text-xs text-on-surface-variant max-w-[280px] leading-relaxed">
                We couldn't retrieve any active or upcoming events from the
                chapter dashboard.
              </p>
            </div>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  import { isUnlocked } from '../../lib/organizer-auth';
  import {
    getActiveChapter,
    ACTIVE_CHAPTER_CHANGED_EVENT,
  } from '../../lib/active-chapter-storage';
  import { fetchBevyEvents } from '../../services/bevy-events-service';
  import { getLiveOrNextEvent } from '../../lib/bevy';
  import type { ActiveChapter } from '../../models/chapter';
  import type { Event } from '../../models/event';

  const baseUrl = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL.slice(0, -1)
    : import.meta.env.BASE_URL;

  // Client-side guard: if locked, redirect to unlock portal index
  if (!isUnlocked()) {
    window.location.replace(`${baseUrl}/organizer`);
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function renderEventView(event: Event | undefined, chapter: ActiveChapter) {
    const container = document.getElementById('organizer-event-container');
    if (!container) return;

    if (!event) {
      container.innerHTML = `
        <div class="card card-outlined border-outline/25 p-8 flex flex-col items-center justify-center text-center gap-3.5 bg-surface/40 rounded-[28px]">
          <div class="w-12 h-12 rounded-full bg-on-surface/5 flex items-center justify-center text-on-surface-variant/40">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <line x1="1" y1="1" x2="23" y2="23"></line>
              <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.5"></path>
              <path d="M5 12.5a10.94 10.94 0 0 1 5.83-2.84"></path>
              <path d="M12 17.5c.78 0 1.5-.34 2-1"></path>
              <path d="M1.02 7a21 21 0 0 1 8.8-3.4"></path>
              <path d="M14.12 3.6A21 21 0 0 1 23 7"></path>
            </svg>
          </div>
          <div class="flex flex-col gap-1">
            <h3 class="text-sm font-extrabold text-on-surface">No Active Event Found</h3>
            <p class="text-xs text-on-surface-variant max-w-[280px] leading-relaxed">
              No active or upcoming events found for <strong>${escapeHtml(chapter.name)}</strong>. Check back later or select another chapter in Chapter Settings.
            </p>
          </div>
        </div>
      `;
      return;
    }

    const hasPhysical =
      event.audienceType === 'IN_PERSON' || event.audienceType === 'HYBRID';
    const hasVirtual =
      event.audienceType === 'VIRTUAL' || event.audienceType === 'HYBRID';

    const addressParts = [
      event.venueAddress,
      event.venueCity,
      event.venueState,
      event.venueZipCode,
    ].filter(Boolean);
    const fullAddress = addressParts.join(', ');

    let tagColor = 'bg-primary/10 text-primary border-primary/20';
    if (event.audienceType === 'VIRTUAL') {
      tagColor = 'bg-tertiary/10 text-tertiary border-tertiary/20';
    } else if (event.audienceType === 'HYBRID') {
      tagColor = 'bg-secondary/10 text-secondary border-secondary/20';
    }

    const DEFAULT_BANNER =
      'https://res.cloudinary.com/startup-grind/image/upload/c_fill,dpr_2.0,f_auto,g_center,q_auto:good/v1/gcs/platform-data-goog/event_banners/GDG_Bevy_DefaultEventBanner_x7tGQf5.png';
    const bannerUrl = event.croppedBannerUrl || DEFAULT_BANNER;

    container.innerHTML = `
      <div class="flex flex-col gap-6">
        <div class="bg-surface rounded-[28px] w-full overflow-hidden flex flex-col border border-outline/10 shadow-elevation-2">
          <div class="w-full aspect-[4/1] relative bg-gradient-to-br from-primary/10 to-secondary/10 shrink-0">
            <img src="${bannerUrl}" alt="Event Banner" class="w-full h-full object-cover" onerror="this.onerror=null; this.src='${DEFAULT_BANNER}';" />
            <span class="absolute top-4 left-4 text-[10px] font-bold px-2.5 py-0.5 rounded-full border bg-surface/90 shadow-sm ${tagColor}">
              ${escapeHtml(event.audienceType.replace('_', ' '))}
            </span>
          </div>
          <div class="px-6 pt-5 pb-4 flex flex-col gap-2">
            <div class="flex justify-between items-start gap-4">
              <h2 class="text-lg font-black text-on-surface leading-tight">${escapeHtml(event.title)}</h2>
              <span class="text-[9px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wider shrink-0 shadow-sm border border-white/10 ${event.statusLabel === 'Live' ? 'bg-error text-white' : 'bg-secondary text-white'}">
                ${escapeHtml(event.statusLabel)}
              </span>
            </div>
            ${event.descriptionShort ? `<p class="text-xs text-on-surface-variant font-medium leading-relaxed">${escapeHtml(event.descriptionShort)}</p>` : ''}
          </div>
          ${event.description ? `<div class="px-6 py-2 border-t border-outline/5"><div class="text-xs text-on-surface-variant leading-relaxed py-2 max-h-48 overflow-y-auto prose prose-sm">${event.description}</div></div>` : ''}
          <div class="px-6 py-4 bg-surface-variant/20 border-t border-outline/10 flex flex-col gap-3">
            <div class="flex items-center gap-3 text-xs text-on-surface">
              <span class="font-bold shrink-0">📅 Date & Time:</span>
              <span>${escapeHtml(event.displayDate)} • ${escapeHtml(event.displayTime)}</span>
            </div>
            ${
              hasPhysical && event.venueName
                ? `
              <div class="flex items-start gap-3 text-xs text-on-surface">
                <span class="font-bold shrink-0">📍 Venue:</span>
                <div class="flex flex-col">
                  <span class="font-semibold">${escapeHtml(event.venueName)}</span>
                  ${fullAddress ? `<span class="text-on-surface-variant text-[11px]">${escapeHtml(fullAddress)}</span>` : ''}
                  ${event.googleMapsLink ? `<a href="${event.googleMapsLink}" target="_blank" rel="noopener noreferrer" class="text-primary text-[11px] font-bold hover:underline mt-0.5 inline-flex items-center gap-1">Open in Google Maps ↗</a>` : ''}
                </div>
              </div>
            `
                : ''
            }
            ${
              hasVirtual && event.virtualVenueLink
                ? `
              <div class="flex items-center gap-3 text-xs text-on-surface">
                <span class="font-bold shrink-0">💻 Virtual Link:</span>
                <a href="${event.virtualVenueLink}" target="_blank" rel="noopener noreferrer" class="text-primary font-bold hover:underline truncate max-w-[200px]">Join Meeting ↗</a>
              </div>
            `
                : ''
            }
            ${
              event.totalAttendees
                ? `
              <div class="flex items-center gap-3 text-xs text-on-surface">
                <span class="font-bold shrink-0">👥 Attendees:</span>
                <span>${event.totalAttendees} registered</span>
              </div>
            `
                : ''
            }
          </div>
        </div>

        <div class="border-t border-outline/10 my-1"></div>

        <!-- Organizer Notes -->
        <div class="card card-outlined border-outline/25 p-4 flex flex-col gap-3 bg-surface/50 rounded-2xl">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-extrabold uppercase text-on-surface-variant tracking-wider flex items-center gap-1.5">
              📝 Organizer Notes
            </h3>
            <span id="organizer-notes-status" class="text-[10px] text-on-surface-variant font-medium">Saved locally</span>
          </div>
          <textarea
            id="organizer-notes-textarea"
            class="w-full bg-surface border border-outline/25 rounded-xl p-3 text-xs text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:border-primary/60 transition-all resize-y min-h-[90px]"
            placeholder="Type confidential reminders or session notes for this event..."
          ></textarea>
        </div>
      </div>
    `;

    // Bind local storage notes for this event
    const textarea = document.getElementById(
      'organizer-notes-textarea'
    ) as HTMLTextAreaElement | null;
    const notesStatus = document.getElementById('organizer-notes-status');
    const storageKey = `gdg-organizer-notes-${event.id}`;

    if (textarea) {
      textarea.value = localStorage.getItem(storageKey) || '';
      textarea.addEventListener('input', () => {
        localStorage.setItem(storageKey, textarea.value);
        if (notesStatus) {
          notesStatus.textContent = 'Saving...';
          setTimeout(() => {
            if (notesStatus) notesStatus.textContent = 'Saved locally';
          }, 600);
        }
      });
    }
  }

  async function syncEventPage(chapter?: ActiveChapter) {
    const active = chapter || getActiveChapter();
    try {
      const events = await fetchBevyEvents(active.id);
      const liveOrNext = getLiveOrNextEvent(events);
      renderEventView(liveOrNext, active);
    } catch (err) {
      console.error('Failed to sync organizer event view:', err);
    }
  }

  // Initial sync if non-default
  const initialChapter = getActiveChapter();
  if (initialChapter.id !== 920) {
    syncEventPage(initialChapter);
  }

  window.addEventListener(ACTIVE_CHAPTER_CHANGED_EVENT, (e: Event) => {
    const customEv = e as CustomEvent<ActiveChapter>;
    syncEventPage(customEv.detail);
  });
</script>
