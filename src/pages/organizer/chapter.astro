---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEFAULT_CHAPTER } from '../../config/default-chapter';
---

<BaseLayout
  title="Chapter Settings | GDG Event Companion"
  description="Search and switch active GDG chapter with Bevy API integration"
>
  <div class="flex flex-col gap-5 py-2 max-w-md mx-auto w-full">
    <!-- Header Navigation -->
    <div class="flex items-center justify-between gap-4 w-full">
      <a
        href={`${import.meta.env.BASE_URL}organizer/dashboard`}
        class="flex items-center gap-1.5 text-xs font-black text-primary hover:underline cursor-pointer select-none"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Dashboard
      </a>
      <h2
        class="text-xs font-extrabold text-on-surface-variant uppercase tracking-wider"
      >
        Organizer Tools
      </h2>
    </div>

    <!-- Title & Description Banner -->
    <div class="flex flex-col gap-1">
      <h1 class="text-xl font-black text-on-surface tracking-tight">
        Chapter Settings
      </h1>
      <p class="text-xs text-on-surface-variant font-medium leading-relaxed">
        Change active GDG chapter to synchronize live events, scripts, and QR
        links.
      </p>
    </div>

    <!-- Current Active Chapter Card -->
    <div
      id="current-chapter-card"
      class="card card-elevated border border-primary/25 p-4 flex flex-col gap-3 bg-surface/80 rounded-2xl shadow-elevation-1 transition-all"
    >
      <div class="flex justify-between items-center">
        <span
          class="text-[10px] font-black tracking-wider uppercase text-primary bg-primary/10 px-2.5 py-0.5 rounded-full"
        >
          Current Chapter
        </span>
        <span
          id="current-chapter-id-badge"
          class="text-[11px] font-mono font-bold text-on-surface-variant bg-surface-variant/40 px-2 py-0.5 rounded-md"
        >
          Chapter ID: {DEFAULT_CHAPTER.id}
        </span>
      </div>

      <div class="flex flex-col gap-1">
        <h2
          id="current-chapter-name"
          class="text-base font-extrabold text-on-surface leading-snug"
        >
          {DEFAULT_CHAPTER.name}
        </h2>
        <div
          class="flex items-center gap-2 text-xs text-on-surface-variant font-medium"
        >
          <span id="current-chapter-location"
            >📍 {DEFAULT_CHAPTER.city}, {DEFAULT_CHAPTER.country}</span
          >
        </div>
      </div>

      <div
        class="flex items-center justify-between border-t border-outline/10 pt-3 mt-1"
      >
        <a
          id="current-chapter-link"
          href={DEFAULT_CHAPTER.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-bold text-primary hover:underline flex items-center gap-1 truncate max-w-[240px]"
        >
          <span>Visit Chapter Site</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3.5 h-3.5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>

        <button
          id="btn-reset-chapter"
          type="button"
          class="text-[11px] font-bold text-on-surface-variant hover:text-error transition-colors px-2 py-1 rounded-lg hover:bg-error/10 cursor-pointer"
        >
          Reset to Default
        </button>
      </div>
    </div>

    <!-- Notification / Status Alert Banner (Hidden by default) -->
    <div
      id="status-banner"
      class="hidden p-3.5 rounded-xl border text-xs font-medium flex items-start gap-2.5 transition-all animate-fadeIn"
      role="alert"
    >
      <span id="status-icon" class="shrink-0 mt-0.5"></span>
      <span id="status-text" class="flex-1 leading-relaxed"></span>
      <button
        id="btn-close-status"
        type="button"
        class="text-on-surface-variant hover:text-on-surface p-0.5 rounded cursor-pointer"
        aria-label="Dismiss alert"
      >
        ✕
      </button>
    </div>

    <!-- Tab / Section 1: Search Chapters -->
    <div
      class="card card-outlined border-outline/25 p-4 flex flex-col gap-3.5 bg-surface/40 rounded-2xl"
    >
      <div class="flex flex-col gap-0.5">
        <h3 class="text-sm font-bold text-on-surface">Search GDG Chapters</h3>
        <p class="text-[11px] text-on-surface-variant">
          Search public chapters by city or name (e.g. <em>GDG Ocala</em>, <em
            >GDG Tampa</em
          >)
        </p>
      </div>

      <!-- Search Input with Debounce (Mobile-first flex container) -->
      <div
        id="search-input-wrapper"
        class="flex items-center gap-2.5 bg-surface border border-outline/25 rounded-full px-3.5 py-2.5 transition-all shadow-xs w-full cursor-text"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4 text-on-surface-variant/60 shrink-0 select-none"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search by chapter name or city..."
          class="w-full bg-transparent border-none p-0 text-xs text-on-surface placeholder:text-on-surface-variant/60 outline-none"
          style="outline: none !important; box-shadow: none !important; border: none !important; -webkit-focus-ring-color: transparent !important;"
          autocomplete="off"
        />
        <button
          id="btn-clear-search"
          type="button"
          style="display: none;"
          class="w-5 h-5 rounded-full bg-on-surface/10 hover:bg-on-surface/20 text-on-surface-variant flex items-center justify-center text-[10px] font-bold shrink-0 cursor-pointer"
          aria-label="Clear search"
        >
          ✕
        </button>
      </div>

      <!-- Search Results Container -->
      <div id="search-results-area" class="flex flex-col gap-2 min-h-[40px]">
        <!-- Populated dynamically by client script -->
        <div
          id="search-placeholder-msg"
          class="text-center py-4 text-xs text-on-surface-variant/60 font-medium"
        >
          Start typing to search public GDG chapters.
        </div>
      </div>
    </div>

    <!-- Divider or -->
    <div class="flex items-center gap-3 my-1">
      <div class="h-px bg-outline/15 flex-1"></div>
      <span
        class="text-[11px] font-extrabold uppercase text-on-surface-variant/60 tracking-wider"
        >or</span
      >
      <div class="h-px bg-outline/15 flex-1"></div>
    </div>

    <!-- Section 2: Manual Chapter ID -->
    <div
      class="card card-outlined border-outline/25 p-4 flex flex-col gap-3.5 bg-surface/40 rounded-2xl"
    >
      <div class="flex flex-col gap-0.5">
        <h3 class="text-sm font-bold text-on-surface">
          Enter Chapter ID Manually
        </h3>
        <p class="text-[11px] text-on-surface-variant">
          Enter a numeric ID from Bevy to validate and load chapter information.
        </p>
      </div>

      <form id="manual-id-form" class="flex items-center gap-2">
        <div class="relative flex-1">
          <input
            id="manual-id-input"
            type="number"
            min="1"
            step="1"
            placeholder="e.g. 933 or 1514"
            class="w-full bg-surface border border-outline/25 rounded-xl py-2.5 px-3 text-xs font-mono text-on-surface placeholder:font-sans placeholder:text-on-surface-variant/60 focus:outline-none focus:border-secondary/60 focus:ring-2 focus:ring-secondary/10 transition-all"
            required
          />
        </div>
        <button
          id="btn-load-chapter"
          type="submit"
          class="btn btn-primary px-4 py-2.5 rounded-xl text-xs font-extrabold flex items-center justify-center gap-1.5 active:scale-95 transition-all shrink-0 cursor-pointer min-h-[40px]"
        >
          <span
            id="load-btn-spinner"
            class="hidden animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full"
          ></span>
          <span id="load-btn-text">Load Chapter</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Confirmation Preview Modal Dialog (Aligned with Project Modal Design) -->
  <div
    id="preview-modal"
    class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="preview-modal-title"
  >
    <div
      class="bg-surface rounded-[28px] max-w-[340px] w-full p-6 flex flex-col gap-4 border border-outline/10 shadow-elevation-5 transform scale-95 transition-transform duration-200"
      style="max-width: 340px;"
    >
      <div class="flex flex-col gap-1">
        <h3
          id="preview-modal-title"
          class="text-base font-extrabold text-on-surface"
        >
          Confirm Active Chapter
        </h3>
        <p class="text-[10px] text-on-surface-variant/80 font-medium">
          Select and switch active chapter
        </p>
      </div>

      <!-- Preview Details Card -->
      <div
        class="bg-surface-variant/30 rounded-2xl p-4 flex flex-col gap-2.5 border border-outline/10"
      >
        <div class="flex items-center justify-between">
          <span
            class="text-[10px] font-black uppercase text-primary tracking-wide"
            >Selected Chapter</span
          >
          <span
            id="preview-chapter-id"
            class="text-[11px] font-mono font-bold text-on-surface-variant bg-surface px-2 py-0.5 rounded border border-outline/10"
          >
            ID: -
          </span>
        </div>

        <h4
          id="preview-chapter-name"
          class="text-sm font-black text-on-surface leading-tight"
        >
          -
        </h4>

        <div
          id="preview-chapter-location-row"
          class="flex items-center gap-1.5 text-xs text-on-surface-variant font-medium"
        >
          <span id="preview-chapter-location">-</span>
        </div>

        <a
          id="preview-chapter-url"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[11px] font-bold text-primary hover:underline truncate mt-1 flex items-center gap-1"
        >
          <span class="truncate">View on community.dev</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3 h-3 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
            ></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <p class="text-[11px] text-on-surface-variant leading-relaxed">
        Setting this chapter will reload event feeds, presenter intro/outro
        scripts, and header badges to match this community.
      </p>

      <!-- Action Buttons (Consistent with app modals) -->
      <div class="flex gap-3.5 mt-2">
        <button
          id="btn-cancel-preview"
          type="button"
          class="btn btn-outlined flex-1 py-2 text-xs font-bold cursor-pointer"
        >
          Cancel
        </button>
        <button
          id="btn-save-chapter"
          type="button"
          class="btn btn-filled flex-1 py-2 text-xs font-bold cursor-pointer"
        >
          Save Chapter
        </button>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { isUnlocked } from '../../lib/organizer-auth';
  import {
    getActiveChapter,
    setActiveChapter,
    resetActiveChapter,
  } from '../../lib/active-chapter-storage';
  import {
    searchBevyChapters,
    fetchChapterById,
  } from '../../services/bevy-chapters-service';
  import { fetchBevyEvents } from '../../services/bevy-events-service';
  import type { ActiveChapter } from '../../models/chapter';
  import { DEFAULT_CHAPTER } from '../../config/default-chapter';

  const baseUrl = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL.slice(0, -1)
    : import.meta.env.BASE_URL;

  // Organizer auth guard
  if (!isUnlocked()) {
    window.location.replace(`${baseUrl}/organizer`);
  }

  // DOM Elements
  const currentChapterName = document.getElementById('current-chapter-name');
  const currentChapterIdBadge = document.getElementById(
    'current-chapter-id-badge'
  );
  const currentChapterLocation = document.getElementById(
    'current-chapter-location'
  );
  const currentChapterLink = document.getElementById(
    'current-chapter-link'
  ) as HTMLAnchorElement | null;

  const btnResetTop = document.getElementById('btn-reset-chapter');

  const searchInput = document.getElementById(
    'search-input'
  ) as HTMLInputElement | null;
  const btnClearSearch = document.getElementById('btn-clear-search');
  const searchResultsArea = document.getElementById('search-results-area');

  const manualIdForm = document.getElementById(
    'manual-id-form'
  ) as HTMLFormElement | null;
  const manualIdInput = document.getElementById(
    'manual-id-input'
  ) as HTMLInputElement | null;
  const btnLoadChapter = document.getElementById('btn-load-chapter');
  const loadBtnSpinner = document.getElementById('load-btn-spinner');
  const loadBtnText = document.getElementById('load-btn-text');

  const statusBanner = document.getElementById('status-banner');
  const statusIcon = document.getElementById('status-icon');
  const statusText = document.getElementById('status-text');
  const btnCloseStatus = document.getElementById('btn-close-status');

  // Preview Modal Elements
  const previewModal = document.getElementById('preview-modal');
  const previewChapterId = document.getElementById('preview-chapter-id');
  const previewChapterName = document.getElementById('preview-chapter-name');
  const previewChapterLocation = document.getElementById(
    'preview-chapter-location'
  );
  const previewChapterUrl = document.getElementById(
    'preview-chapter-url'
  ) as HTMLAnchorElement | null;
  const btnCancelPreview = document.getElementById('btn-cancel-preview');
  const btnSaveChapter = document.getElementById('btn-save-chapter');

  // Pending chapter awaiting confirmation
  let pendingChapter: ActiveChapter | null = null;
  let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;

  // Render Current Active Chapter Card
  function renderActiveChapterUI() {
    const active = getActiveChapter();
    if (currentChapterName) currentChapterName.textContent = active.name;
    if (currentChapterIdBadge)
      currentChapterIdBadge.textContent = `Chapter ID: ${active.id}`;

    if (currentChapterLocation) {
      const locParts = [active.city, active.country].filter(Boolean);
      currentChapterLocation.textContent =
        locParts.length > 0
          ? `📍 ${locParts.join(', ')}`
          : '📍 Public GDG Chapter';
    }

    if (currentChapterLink) {
      currentChapterLink.href =
        active.url || `https://gdg.community.dev/chapter/${active.id}/`;
      currentChapterLink.title = active.name;
    }
  }

  // Show status banner notification
  function showStatus(
    message: string,
    type: 'success' | 'error' | 'warning' = 'success'
  ) {
    if (!statusBanner || !statusText || !statusIcon) return;

    statusBanner.className =
      'p-3.5 rounded-xl border text-xs font-medium flex items-start gap-2.5 transition-all animate-fadeIn ';

    if (type === 'success') {
      statusBanner.classList.add(
        'bg-secondary/10',
        'border-secondary/30',
        'text-secondary'
      );
      statusIcon.textContent = '✓';
    } else if (type === 'error') {
      statusBanner.classList.add(
        'bg-error/10',
        'border-error/30',
        'text-error'
      );
      statusIcon.textContent = '✕';
    } else {
      statusBanner.classList.add(
        'bg-tertiary/10',
        'border-tertiary/30',
        'text-tertiary'
      );
      statusIcon.textContent = '⚠️';
    }

    statusText.textContent = message;
    statusBanner.classList.remove('hidden');

    if (type === 'success') {
      setTimeout(() => {
        statusBanner.classList.add('hidden');
      }, 5000);
    }
  }

  btnCloseStatus?.addEventListener('click', () => {
    statusBanner?.classList.add('hidden');
  });

  // Open Preview Modal
  function openPreviewModal(chapter: ActiveChapter) {
    pendingChapter = chapter;
    if (previewChapterId) previewChapterId.textContent = `ID: ${chapter.id}`;
    if (previewChapterName) previewChapterName.textContent = chapter.name;

    if (previewChapterLocation) {
      const locParts = [chapter.city, chapter.country].filter(Boolean);
      previewChapterLocation.textContent =
        locParts.length > 0
          ? `📍 ${locParts.join(', ')}`
          : '📍 Global Community';
    }

    if (previewChapterUrl) {
      const url =
        chapter.url || `https://gdg.community.dev/chapter/${chapter.id}/`;
      previewChapterUrl.href = url;
      previewChapterUrl.textContent = url.replace('https://', '');
    }

    if (previewModal) {
      previewModal.classList.remove('opacity-0', 'pointer-events-none');
      previewModal.classList.add('opacity-100', 'pointer-events-auto');
      const dialog = previewModal.querySelector('div');
      dialog?.classList.remove('scale-95');
      dialog?.classList.add('scale-100');
    }
  }

  function closePreviewModal() {
    pendingChapter = null;
    if (previewModal) {
      previewModal.classList.remove('opacity-100', 'pointer-events-auto');
      previewModal.classList.add('opacity-0', 'pointer-events-none');
      const dialog = previewModal.querySelector('div');
      dialog?.classList.remove('scale-100');
      dialog?.classList.add('scale-95');
    }
  }

  btnCancelPreview?.addEventListener('click', closePreviewModal);

  // Save Confirmed Chapter
  btnSaveChapter?.addEventListener('click', () => {
    if (!pendingChapter) return;
    const selected = pendingChapter;
    setActiveChapter(selected);
    closePreviewModal();
    renderActiveChapterUI();
    clearSearchState();

    // Pre-fetch events for instant load on Home screen
    fetchBevyEvents(selected.id).catch(() => {});

    showStatus(
      `Active chapter successfully changed to "${selected.name}"!`,
      'success'
    );
  });

  let activeSearchSequence = 0;

  function clearSearchState() {
    activeSearchSequence++;
    if (searchDebounceTimer) {
      clearTimeout(searchDebounceTimer);
      searchDebounceTimer = null;
    }
    if (searchInput) {
      searchInput.value = '';
      searchInput.blur();
    }
    if (btnClearSearch) {
      btnClearSearch.style.display = 'none';
    }
    if (searchResultsArea) {
      searchResultsArea.innerHTML = `
        <div id="search-placeholder-msg" class="text-center py-4 text-xs text-on-surface-variant/60 font-medium">
          Start typing to search public GDG chapters.
        </div>
      `;
    }
    if (manualIdInput) {
      manualIdInput.value = '';
    }
  }

  // Search Handler with Debounce
  function handleSearchInput() {
    const query = searchInput?.value.trim() || '';

    if (btnClearSearch) {
      btnClearSearch.style.display = query.length > 0 ? 'flex' : 'none';
    }

    if (searchDebounceTimer) {
      clearTimeout(searchDebounceTimer);
    }

    if (!query) {
      if (searchResultsArea) {
        searchResultsArea.innerHTML = `
          <div class="text-center py-4 text-xs text-on-surface-variant/60 font-medium">
            Start typing to search public GDG chapters.
          </div>
        `;
      }
      return;
    }

    const currentSeq = ++activeSearchSequence;

    // Debounce by 400ms
    searchDebounceTimer = setTimeout(async () => {
      if (!searchResultsArea || currentSeq !== activeSearchSequence) return;

      searchResultsArea.innerHTML = `
        <div class="flex items-center justify-center gap-2 py-5 text-xs text-on-surface-variant font-medium">
          <span class="animate-spin w-4 h-4 border-2 border-primary border-t-transparent rounded-full"></span>
          Searching public chapters...
        </div>
      `;

      try {
        const results = await searchBevyChapters(query);
        if (currentSeq !== activeSearchSequence) return;

        if (results.length === 0) {
          searchResultsArea.innerHTML = `
            <div class="card card-outlined border-outline/20 p-4 text-center rounded-xl bg-surface-variant/20 flex flex-col items-center gap-1">
              <span class="text-xs font-bold text-on-surface">No chapters found</span>
              <span class="text-[11px] text-on-surface-variant">We couldn't find any GDG chapters matching "${query}". Try searching by city name or enter the Chapter ID below.</span>
            </div>
          `;
          return;
        }

        // Render matching chapter cards
        searchResultsArea.innerHTML = '';
        results.forEach((chapter) => {
          const card = document.createElement('div');
          card.className =
            'card card-outlined border-outline/20 hover:border-primary/50 bg-surface/70 p-3 rounded-xl flex items-center justify-between gap-3 transition-all';

          const locText = [chapter.city, chapter.country]
            .filter(Boolean)
            .join(', ');

          card.innerHTML = `
            <div class="flex flex-col gap-0.5 overflow-hidden">
              <div class="flex items-center gap-1.5">
                <h4 class="text-xs font-extrabold text-on-surface truncate">${chapter.name}</h4>
                <span class="text-[10px] font-mono text-on-surface-variant/70 bg-surface-variant/40 px-1.5 py-0.2 rounded shrink-0">ID: ${chapter.id}</span>
              </div>
              <span class="text-[11px] text-on-surface-variant truncate">📍 ${locText || 'GDG Chapter'}</span>
            </div>
            <button
              type="button"
              class="btn-select-chapter btn btn-tonal text-xs font-extrabold px-3 py-1.5 rounded-lg shrink-0 hover:bg-primary hover:text-white transition-all cursor-pointer"
            >
              Select
            </button>
          `;

          const selectBtn = card.querySelector('.btn-select-chapter');
          selectBtn?.addEventListener('click', () => {
            openPreviewModal(chapter);
          });

          searchResultsArea.appendChild(card);
        });
      } catch (err: unknown) {
        if (currentSeq !== activeSearchSequence) return;
        const message =
          err instanceof Error ? err.message : 'Failed to search chapters.';
        searchResultsArea.innerHTML = `
          <div class="p-3 bg-error/10 border border-error/25 rounded-xl text-xs text-error font-medium">
            ${message}
          </div>
        `;
      }
    }, 400);
  }

  searchInput?.addEventListener('input', handleSearchInput);

  btnClearSearch?.addEventListener('click', () => {
    clearSearchState();
    searchInput?.focus();
  });

  // Manual Chapter ID Validation
  manualIdForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const rawVal = manualIdInput?.value.trim();
    if (!rawVal) return;

    const numericId = parseInt(rawVal, 10);
    if (isNaN(numericId) || numericId <= 0) {
      showStatus('Please enter a valid numeric Chapter ID.', 'warning');
      return;
    }

    // Set loading state
    if (btnLoadChapter) (btnLoadChapter as HTMLButtonElement).disabled = true;
    loadBtnSpinner?.classList.remove('hidden');
    if (loadBtnText) loadBtnText.textContent = 'Validating...';

    try {
      const verifiedChapter = await fetchChapterById(numericId);
      // Validated successfully: open confirmation preview (does not overwrite immediately)
      openPreviewModal(verifiedChapter);
    } catch (err: unknown) {
      // Do not overwrite current active chapter on failed validation
      const message =
        err instanceof Error
          ? err.message
          : 'Validation failed for chapter ID.';
      showStatus(message, 'error');
    } finally {
      if (btnLoadChapter)
        (btnLoadChapter as HTMLButtonElement).disabled = false;
      loadBtnSpinner?.classList.add('hidden');
      if (loadBtnText) loadBtnText.textContent = 'Load Chapter';
    }
  });

  // Reset to Default Chapter Handler
  function performReset() {
    resetActiveChapter();
    renderActiveChapterUI();
    clearSearchState();
    showStatus(
      `Restored default chapter (${DEFAULT_CHAPTER.name} / ID ${DEFAULT_CHAPTER.id}).`,
      'success'
    );
  }

  btnResetTop?.addEventListener('click', performReset);

  // Initialize view
  renderActiveChapterUI();
</script>

<style>
  #search-input-wrapper {
