---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { fetchChapterEvents } from '../lib/bevy';

const rawEvents = await fetchChapterEvents();
const allEvents = rawEvents
  .filter((e) => e.statusLabel === 'Upcoming' || e.statusLabel === 'Live')
  .sort((a, b) => {
    if (a.statusLabel === 'Live' && b.statusLabel !== 'Live') return -1;
    if (b.statusLabel === 'Live' && a.statusLabel !== 'Live') return 1;
    return new Date(a.startDate).getTime() - new Date(b.startDate).getTime();
  });

const calculateDaysRemaining = (startDateString: string) => {
  const diffTime = new Date(startDateString).getTime() - new Date().getTime();
  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
  return diffDays > 0 ? diffDays : 0;
};
---

<BaseLayout
  title="Events | GDG Event Companion"
  description="Organizer guide to upcoming community events"
>
  <div class="flex flex-col gap-4">
    <div class="flex flex-col gap-1">
      <h2 class="text-xl font-bold">Upcoming Events</h2>
      <p class="text-[12px] text-on-surface-variant leading-relaxed">
        Invite guests to join our other upcoming events throughout the year by
        going to our online event page.
      </p>
    </div>

    <div id="events-list-container" class="flex flex-col gap-3.5 mt-2">
      {
        allEvents.length > 0 ? (
          allEvents.map((event) => {
            let tagColor = 'bg-primary/10 text-primary border-primary/20';
            if (event.audienceType === 'VIRTUAL') {
              tagColor = 'bg-tertiary/10 text-tertiary border-tertiary/20';
            } else if (event.audienceType === 'HYBRID') {
              tagColor = 'bg-secondary/10 text-secondary border-secondary/20';
            }

            const daysRemaining = calculateDaysRemaining(event.startDate);

            return (
              <div
                class={`relative card card-outlined p-4 flex justify-between items-center transition-all duration-200 rounded-2xl cursor-pointer ${
                  event.statusLabel === 'Live'
                    ? 'border-error/40 bg-error/[0.02] shadow-sm hover:border-error/60'
                    : 'border-outline/25 bg-surface/50 hover:border-primary/50'
                }`}
                data-event={JSON.stringify(event)}
              >
                {event.statusLabel === 'Live' ? (
                  <span class="absolute -top-2.5 right-4 flex items-center gap-1 bg-error text-white text-[9px] font-black uppercase px-2 py-0.5 rounded-full tracking-wider shadow-sm animate-pulse border border-white/15 z-10">
                    <span class="w-1.5 h-1.5 rounded-full bg-white" />
                    NOW
                  </span>
                ) : (
                  <span class="absolute -top-2.5 right-4 flex items-center gap-1 bg-primary text-white text-[9px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wider shadow-sm border border-white/15 z-10">
                    {daysRemaining} {daysRemaining === 1 ? 'Day' : 'Days'}
                  </span>
                )}

                <div class="flex flex-col gap-1 max-w-[70%]">
                  <span class="text-[12px] font-bold text-on-surface-variant">
                    {event.displayDate} • {event.displayTime}
                  </span>
                  <h3 class="text-sm font-bold text-on-surface truncate">
                    {event.title}
                  </h3>
                  <span class="text-[11px] text-on-surface/60 font-medium flex items-center gap-1">
                    <Icon
                      name="venue"
                      size={12}
                      class="text-primary/70 shrink-0"
                    />
                    {event.displayLocation}
                  </span>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  <span
                    class={`text-[11px] font-bold px-2 py-0.5 rounded-full border ${tagColor}`}
                  >
                    {event.audienceType.replace('_', ' ')}
                  </span>
                </div>
              </div>
            );
          })
        ) : (
          <div class="card card-outlined border-outline/25 p-8 flex flex-col items-center text-center justify-center gap-2 bg-surface/30 rounded-2xl">
            <Icon
              name="calendar"
              size={24}
              class="text-on-surface-variant/60"
            />
            <h3 class="text-sm font-bold text-on-surface">
              No Events Scheduled
            </h3>
            <p class="text-[12px] text-on-surface-variant/80 max-w-[80%] leading-relaxed">
              We are working on bringing you exciting new community sessions.
              Stay tuned for updates!
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  import {
    getActiveChapter,
    ACTIVE_CHAPTER_CHANGED_EVENT,
  } from '../lib/active-chapter-storage';
  import { fetchBevyEvents } from '../services/bevy-events-service';
  import type { ActiveChapter } from '../models/chapter';
  import type { Event } from '../models/event';

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function calculateDaysRemaining(startDateString: string): number {
    const diffTime = new Date(startDateString).getTime() - new Date().getTime();
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    return diffDays > 0 ? diffDays : 0;
  }

  async function syncEventsPage(chapter?: ActiveChapter) {
    const active = chapter || getActiveChapter();
    const container = document.getElementById('events-list-container');
    if (!container) return;

    try {
      const rawEvents = await fetchBevyEvents(active.id);
      const allEvents = rawEvents
        .filter((e) => e.statusLabel === 'Upcoming' || e.statusLabel === 'Live')
        .sort((a, b) => {
          if (a.statusLabel === 'Live' && b.statusLabel !== 'Live') return -1;
          if (b.statusLabel === 'Live' && a.statusLabel !== 'Live') return 1;
          return (
            new Date(a.startDate).getTime() - new Date(b.startDate).getTime()
          );
        });

      if (allEvents.length === 0) {
        container.innerHTML = `
          <div class="card card-outlined border-outline/25 p-8 flex flex-col items-center text-center justify-center gap-2 bg-surface/30 rounded-2xl">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-on-surface-variant/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <h3 class="text-sm font-bold text-on-surface">No Events Scheduled</h3>
            <p class="text-[12px] text-on-surface-variant/80 max-w-[80%] leading-relaxed">
              No upcoming events currently scheduled for ${escapeHtml(active.name)}. Check back soon!
            </p>
          </div>
        `;
        return;
      }

      container.innerHTML = allEvents
        .map((event: Event) => {
          let tagColor = 'bg-primary/10 text-primary border-primary/20';
          if (event.audienceType === 'VIRTUAL') {
            tagColor = 'bg-tertiary/10 text-tertiary border-tertiary/20';
          } else if (event.audienceType === 'HYBRID') {
            tagColor = 'bg-secondary/10 text-secondary border-secondary/20';
          }
          const daysRemaining = calculateDaysRemaining(event.startDate);
          const isLive = event.statusLabel === 'Live';

          return `
          <div
            class="relative card card-outlined p-4 flex justify-between items-center transition-all duration-200 rounded-2xl cursor-pointer ${
              isLive
                ? 'border-error/40 bg-error/[0.02] shadow-sm hover:border-error/60'
                : 'border-outline/25 bg-surface/50 hover:border-primary/50'
            }"
            data-event='${escapeHtml(JSON.stringify(event))}'
          >
            ${
              isLive
                ? `<span class="absolute -top-2.5 right-4 flex items-center gap-1 bg-error text-white text-[9px] font-black uppercase px-2 py-0.5 rounded-full tracking-wider shadow-sm animate-pulse border border-white/15 z-10">
                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                    NOW
                  </span>`
                : `<span class="absolute -top-2.5 right-4 flex items-center gap-1 bg-primary text-white text-[9px] font-black uppercase px-2.5 py-0.5 rounded-full tracking-wider shadow-sm border border-white/15 z-10">
                    ${daysRemaining} ${daysRemaining === 1 ? 'Day' : 'Days'}
                  </span>`
            }

            <div class="flex flex-col gap-1 max-w-[70%]">
              <span class="text-[12px] font-bold text-on-surface-variant">
                ${escapeHtml(event.displayDate)} • ${escapeHtml(event.displayTime)}
              </span>
              <h3 class="text-sm font-bold text-on-surface truncate">
                ${escapeHtml(event.title)}
              </h3>
              <span class="text-[11px] text-on-surface/60 font-medium flex items-center gap-1">
                📍 ${escapeHtml(event.displayLocation)}
              </span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="text-[11px] font-bold px-2 py-0.5 rounded-full border ${tagColor}">
                ${escapeHtml(event.audienceType.replace('_', ' '))}
              </span>
            </div>
          </div>
        `;
        })
        .join('');
    } catch (err) {
      console.error('Failed to sync events page with active chapter:', err);
    }
  }

  // Initial sync if non-default
  const initialChapter = getActiveChapter();
  if (initialChapter.id !== 920) {
    syncEventsPage(initialChapter);
  }

  window.addEventListener(ACTIVE_CHAPTER_CHANGED_EVENT, (e: Event) => {
    const customEv = e as CustomEvent<ActiveChapter>;
    syncEventsPage(customEv.detail);
  });
</script>
